# The backend's settings, read by scripts/start-backend.sh and by `pnpm --filter @my-life/backend start`.
# Comma-separated emails of the Google accounts whose extensions may report (CLAUDE.md locked decision 19).
MY_LIFE_ALLOWED_EMAILS=
# Optional, with their defaults:
# MY_LIFE_PORT=7777
# MY_LIFE_DATABASE_PATH=~/Library/Application Support/my-life/my-life.sqlite
# MY_LIFE_DASHBOARD_DIRECTORY=apps/dashboard/dist
# MY_LIFE_GMAIL_POLLING_INTERVAL_SECONDS=60
# MY_LIFE_DAILY_SPEND_CEILING_USD=20
# MY_LIFE_TRIAGE_MODEL=claude-haiku-5-5
# MY_LIFE_TRIAGE_ESCALATION_MODEL=claude-opus-5-5
# MY_LIFE_SUMMARY_MODEL=claude-haiku-5-5
# MY_LIFE_PRIORITIZATION_MODEL=claude-opus-5-5
# MY_LIFE_AGENT_MODEL=claude-opus-5-5
# MY_LIFE_UNANSWERED_ASK_BUSINESS_DAYS=2
# MY_LIFE_SLACK_POLLING_INTERVAL_SECONDS=60
# Set to off to stop polling Slack while keeping the tokens above.
# MY_LIFE_SLACK_POLLING=off
# How many days back a first Slack poll reads (default 7).
# MY_LIFE_SLACK_FIRST_POLL_LOOKBACK_DAYS=7
# MY_LIFE_SLACK_API_URL=https://slack.com/api
# Slack (Phase 5): one app per workspace, installed with user token scopes. From each app's Basic Information page.
# MY_LIFE_SLACK_WORKSPACE_1_TEAM_ID=
# MY_LIFE_SLACK_WORKSPACE_1_APP_ID=
# MY_LIFE_SLACK_WORKSPACE_1_CLIENT_ID=
# MY_LIFE_SLACK_WORKSPACE_1_CLIENT_SECRET=
# MY_LIFE_SLACK_WORKSPACE_2_TEAM_ID=
# MY_LIFE_SLACK_WORKSPACE_2_APP_ID=
# MY_LIFE_SLACK_WORKSPACE_2_CLIENT_ID=
# MY_LIFE_SLACK_WORKSPACE_2_CLIENT_SECRET=
# Each app's OAuth & Permissions → User OAuth Token (xoxp-…), after installing it with the user token scopes.
# MY_LIFE_SLACK_WORKSPACE_1_USER_TOKEN=
# MY_LIFE_SLACK_WORKSPACE_2_USER_TOKEN=

# Telegram (Phase 6): https://my.telegram.org → API development tools.
# MY_LIFE_TELEGRAM_API_ID=
# MY_LIFE_TELEGRAM_API_HASH=
# Optional: where scripts/telegram-login.sh writes the session (default ~/Library/Application Support/my-life/telegram-session).
# MY_LIFE_TELEGRAM_SESSION_PATH=
