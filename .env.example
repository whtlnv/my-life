# The backend's settings, read by scripts/start-backend.sh and by `pnpm --filter @my-life/backend start`.
# Comma-separated emails of the Google accounts whose extensions may report (CLAUDE.md locked decision 19).
MY_LIFE_ALLOWED_EMAILS=
# Optional, with their defaults:
# MY_LIFE_PORT=7777
# MY_LIFE_DATABASE_PATH=~/Library/Application Support/my-life/my-life.sqlite
# MY_LIFE_DASHBOARD_DIRECTORY=apps/dashboard/dist
